# --- Database ---
# Production: postgresql+psycopg2://user:password@host:5432/cycleai
# Local dev fallback (no server needed): sqlite:///./cycleai_dev.db
DATABASE_URL=postgresql+psycopg2://cycleai:cycleai@localhost:5432/cycleai

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Field-level encryption (Fernet) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- OpenAI (AI Coach) ---
# If unset, the AI Coach falls back to a deterministic template responder
# so the API remains fully runnable in dev/CI without a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Redis (optional cache) ---
# If unset, caching is silently disabled — Redis is not required to run the API.
REDIS_URL=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://cycleai.app
